# Your Postgres database. The workbench keeps its own tables in a separate "workbench" schema.
DATABASE_URL=postgres://user:password@localhost:5432/yourdb

# Optional: a separate connection for the db.query tool. Use a role that can only SELECT the tables you choose.
# DATA_DATABASE_URL=postgres://readonly_agent:password@localhost:5432/yourdb

ANTHROPIC_API_KEY=

# Folders the agent may ever touch (separated by ":" on Mac/Linux, ";" on Windows). Task files can only narrow this.
WORKBENCH_ROOTS=~/Downloads:~/Documents/agent-sandbox

# Optional
# WORKBENCH_PORT=8787
# WORKBENCH_UI_TOKEN=
# WORKBENCH_MODEL=claude-sonnet-5-5
